{
  "name": "shim-shim",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/training.test.ts tests/data.test.ts tests/assistant.test.ts",
    "export:web": "expo export --platform web",
    "export:preview": "expo export --platform web --output-dir build-check --max-workers 2",
    "ai": "node --import tsx server/index.ts",
    "test:ai": "node --import tsx scripts/smoke-ai.ts",
    "build:hosted": "npm run export:preview && node scripts/build-hosted.mjs"
  },
  "private": true
}
