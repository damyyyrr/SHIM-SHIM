# Proveedor principal: API online con cuota gratuita. La clave vive SOLO en el servidor.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternativa opcional: AI_PROVIDER=ollama para inferencia local.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT=12288
AI_HOST=127.0.0.1
AI_PORT=8787
STATIC_DIRECTORY=build-check

# Solo para compilaciones nativas: URL de un backend con autenticación compatible.
# La web usa /api en el mismo origen. Sites requiere iniciar sesión en el navegador.
# EXPO_PUBLIC_AI_SERVER_URL=https://tu-backend.example
